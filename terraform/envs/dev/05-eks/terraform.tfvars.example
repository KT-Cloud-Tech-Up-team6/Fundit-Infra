project_name        = "fundit"
environment         = "dev"
cluster_version     = "1.35"
node_instance_types = ["t3.medium"]
desired_size        = 2
min_size            = 2
max_size            = 4

# Stateful 전용 노드그룹 설정 (이슈 #71)
enable_stateful_node_group   = true
stateful_instance_types      = ["t3a.large", "t3.large"]
stateful_desired_size_per_az = 1
stateful_min_size_per_az     = 1
stateful_max_size_per_az     = 2

common_tags = {
  Project   = "Fundit"
  Team      = "Team6"
  ManagedBy = "Terraform"
}
